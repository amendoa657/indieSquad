# Copie esse arquivo pra .env e troque os valores.
# O .env nao vai pro repositorio, cada pessoa do grupo tem o seu.

# Chave secreta que assina o token do login.
# Gere a sua com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-essa-chave-antes-de-rodar

# Conexao com o banco, no formato usuario:senha@host/nomeDoBanco
DATABASE_URL=mysql+pymysql://root@localhost/indieSquad?charset=utf8mb4

# Quantas horas o token do login continua valido
HORAS_EXPIRACAO_TOKEN=12

# Enderecos do front que podem chamar essa API, separados por virgula
ORIGENS_PERMITIDAS=http://127.0.0.1:5500,http://localhost:5500

# Deixe 1 no seu computador e 0 em producao
DEBUG=1

# LLM que escreve a explicacao do match entre candidato e vaga.
# Deixe a chave vazia e o sistema usa a explicacao gerada localmente: o match
# continua funcionando, so nao sai escrito em linguagem natural.
#
# A chave gratuita da Groq sai em console.groq.com/keys, sem cartao.
# Confira em console.groq.com/docs/models o nome do modelo disponivel hoje:
# a lista muda de tempos em tempos.
IA_URL=https://api.groq.com/openai/v1/chat/completions
IA_CHAVE=
IA_MODELO=llama-3.3-70b-versatile
IA_TEMPO_LIMITE=8
